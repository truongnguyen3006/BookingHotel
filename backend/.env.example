# Copy to backend/.env for local Docker Compose usage. backend/.env is gitignored.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

MYSQL_DATABASE=booking_hotel
MYSQL_USER=booking_app
MYSQL_PASSWORD=booking_app_password
MYSQL_ROOT_PASSWORD=root_password

# Used when running Spring Boot directly on the host.
DB_URL=jdbc:mysql://localhost:3306/booking_hotel?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=booking_app
DB_PASSWORD=booking_app_password

# Local-development example only. Generate a different strong Base64 key for staging/prod.
JWT_SECRET_B64=Ym9va2luZy1ob3RlbC1kZXYtc2VjcmV0LWtleS1tdXN0LWJlLWF0LWxlYXN0LTMyLWJ5dGVz
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Staging/prod optional pool sizing
DB_POOL_MAX=10
DB_POOL_MIN=2

# VNPAY Sandbox
VNP_TMN_CODE=B0X8KC9I
VNP_HASH_SECRET=replace_with_your_vnpay_hash_secret
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://bookinghotel-production.up.railway.app/api/payments/vnpay/return
VNP_EXPIRE_MINUTES=15
VNP_CONFIRMATION_GRACE_SECONDS=120

# Reservation lifecycle hardening
BOOKING_RESERVATION_MINUTES=15
BOOKING_EXPIRATION_SCAN_MS=60000
