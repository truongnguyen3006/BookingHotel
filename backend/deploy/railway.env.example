# Paste/adapt these in the Railway backend service Variables tab.
SPRING_PROFILES_ACTIVE=prod

# Reference the Railway MySQL service by its actual service name.
DB_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_POOL_MAX=10
DB_POOL_MIN=2

# Generate a strong Base64 secret; do not commit the real value.
JWT_SECRET_B64=REPLACE_WITH_STRONG_BASE64_SECRET
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Optional one-time/idempotent ADMIN bootstrap.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_DISPLAY_NAME=Hotel Admin
